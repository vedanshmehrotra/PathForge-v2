        "code_text": "def pal_recursive(s):\n    cleaned = [c.lower() for c in s if c.isalnum()]\n\n    def check(lo, hi):\n        if lo >= hi:\n            return True\n        if cleaned[lo] != cleaned[hi]:\n            return False\n        return check(lo + 1, hi - 1)\n\n    return check(0, len(cleaned) - 1)\n"
