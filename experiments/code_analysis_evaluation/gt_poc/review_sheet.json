      ],
      "reference_solution": {
        "solution_id": "S0016",
        "source_type": "pathforge_db",
        "source_ref": "submissions.id=190",
        "code_text": "class Solution:\n    def minSubArrayLen(self, target: int, nums: List[int]) -> int:\n        left = 0\n        summ = 0\n        ans = len(nums) + 1\n\n        for right in range(len(nums)):\n            summ += nums[right]\n\n            while summ >= target:\n                ans = min(ans, right - left + 1)\n                summ -= nums[left]\n                left += 1\n\n        if ans == len(nums) + 1:\n            return 0\n\n        return ans"
      },
