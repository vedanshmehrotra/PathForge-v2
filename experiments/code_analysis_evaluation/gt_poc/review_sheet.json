        "source_type": "pathforge_db",
        "source_ref": "submissions.id=235",
        "code_text": "class Solution:\n    def search(self, nums: List[int], target: int) -> int:\n        left = 0\n        right = len(nums) - 1\n\n        while left <= right:\n            mid = (left + right) // 2\n\n            if nums[mid] == target:\n                return mid\n\n            if nums[mid] < target:\n                left = mid + 1\n            else:\n                right = mid - 1\n\n        return -1"
      },
