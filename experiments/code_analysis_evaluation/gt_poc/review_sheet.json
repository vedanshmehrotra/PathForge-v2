        "code_text": "def merge_collect_sort(head_a, head_b):\n    values = []\n    while head_a is not None:\n        values.append(head_a.val)\n        head_a = head_a.next\n    while head_b is not None:\n        values.append(head_b.val)\n        head_b = head_b.next\n    values.sort()\n    dummy = ListNode(0)\n    tail = dummy\n    for value in values:\n        tail.next = ListNode(value)\n        tail = tail.next\n    return dummy.next\n"
