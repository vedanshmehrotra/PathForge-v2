        "source_ref": "submissions.id=194",
        "code_text": "class Solution:\n    def missingInteger(self, nums: List[int]) -> int:\n        i = 1\n        summ = nums[0]\n\n        while i < len(nums) and nums[i] == nums[i - 1] + 1:\n            summ += nums[i]\n            i += 1\n\n        while summ in nums:\n            summ += 1\n\n        return summ"
      },
