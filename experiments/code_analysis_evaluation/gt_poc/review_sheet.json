        "code_text": "def two_sum_sorted_two_pointer(nums, target):\n    ordered = sorted(range(len(nums)), key=lambda i: nums[i])\n    lo = 0\n    hi = len(ordered) - 1\n    while lo < hi:\n        total = nums[ordered[lo]] + nums[ordered[hi]]\n        if total == target:\n            return [ordered[lo], ordered[hi]]\n        if total < target:\n            lo += 1\n        else:\n            hi -= 1\n    return []\n"
      },
